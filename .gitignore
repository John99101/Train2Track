*.iml
.gradle
/local.properties
/.idea
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
google-services.json

# Release signing — keep these private, never commit
keystore.properties
*.jks
*.keystore

# --- iOS / Xcode / Swift Package Manager ---
# Build products & caches (huge — never commit)
ios/build/
ios/**/build/
ios/spm-cache/
.build/
DerivedData/
*.xcarchive
*.ipa

# Fastlane / Bundler local files and signing material
ios/.bundle/
ios/vendor/
ios/fastlane/report.xml
ios/fastlane/README.md
ios/fastlane/.env*
# App Store Connect API key JSON files (including local files named by Key ID)
ios/*.json
*.p12
*.mobileprovision

# Xcode per-user state
xcuserdata/
*.xcuserstate
.swiftpm/

# Firebase iOS config — client config, kept private like google-services.json.
# Each machine drops its own copy into the app target.
GoogleService-Info.plist

# Apple push key
*.p8

# Gradle/Android module build outputs (any level)
build/
app/build/

# Firebase CLI local artifacts (deploy cache + debug logs)
.firebase/
firebase-debug.log
*.log

# Kotlin 2.x build data
.kotlin/
