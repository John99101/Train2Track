    <!-- Einwilligung -->
    <string name="consent_title">Bevor du startest</string>
    <string name="consent_intro">Die App nutzt nur, was sie braucht, um dir den Nahverkehr live anzuzeigen. Die Optionen unten sind aus, bis du sie einschaltest. Du kannst all das später in den Einstellungen ändern oder deine Daten jederzeit löschen.</string>
    <string name="consent_analytics_title">Nutzungsstatistik</string>
    <string name="consent_analytics_desc">Erlaubt Google Analytics zu zählen, wie die App genutzt wird, damit wir sie verbessern können. Aus, solange du es nicht einschaltest.</string>
    <string name="consent_location_title">Standort</string>
    <string name="consent_location_desc">Wählt deine Stadt vor und zeigt deine Position auf der Karte. Dein Standort bleibt auf deinem Gerät.</string>
    <string name="consent_continue">Weiter</string>

