    <!-- Consent -->
    <string name="consent_title">Before you start</string>
    <string name="consent_intro">The app only uses what it needs to show live public transport. The options below are off unless you turn them on. You can change all of this later in Settings, or delete your data at any time.</string>
    <string name="consent_analytics_title">Usage statistics</string>
    <string name="consent_analytics_desc">Lets Google Analytics count how the app is used, so we can improve it. Off unless you switch it on.</string>
    <string name="consent_location_title">Location</string>
    <string name="consent_location_desc">Preselects your city and shows your position on the map. Your location stays on your phone.</string>
    <string name="consent_continue">Continue</string>

