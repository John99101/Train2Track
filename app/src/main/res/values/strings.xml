    <!-- Data sources and open source -->
    <string name="about_title">Data sources and open source</string>
    <string name="about_intro">Train2Track uses open data. The providers are not responsible for the app.</string>
    <string name="about_transit_title">Timetable and live data</string>
    <string name="about_transit_body">Transitous, an open routing service run by volunteers on the open source software MOTIS. All of its sources and their licences are listed at transitous.org/sources. For Germany these are mainly data of DELFI e.V.: timetable data under CC BY 4.0, live data under CC BY SA.</string>
    <string name="about_disruptions_title">Disruption notices</string>
    <string name="about_disruptions_body">gtfs.de, under the licence CC BY SA 4.0.</string>
    <string name="about_map_title">Map</string>
    <string name="about_map_body">© OpenStreetMap contributors. The map data is available under the Open Database License.</string>
    <string name="about_converted">The data is shortened and converted for display. Converted data from sources under the licence CC BY SA stays under that licence.</string>
    <string name="about_open_source_title">Open source</string>
    <string name="about_open_source_body">The source code of the apps and of the server is public under the licence GNU AGPL 3.0. The name Train2Track and the logo are not part of that licence.</string>
    <string name="about_github">Source code on GitHub</string>

