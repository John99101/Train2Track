rules_version = '2';

// EMERGENCY RULES: no app can write anything (no reports, votes, statistics or
// activity signals), for a spam wave or a fault. The apps keep showing what is
// there, sending a report shows an error. The server functions are not affected
// (they bypass the rules): the cleanup and "Delete my data" keep working.
//
// Switch on:   firebase deploy --only firestore:rules --config firebase.lockdown.json
// Switch off:  firebase deploy --only firestore:rules
// (or Firebase console, Firestore, Rules, history: restore the earlier version)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /reports/{reportId} { allow read: if signedIn(); }
    match /delay_reports/{voteId} { allow read: if signedIn(); }
    match /disruptions/{alertId} { allow read: if signedIn(); }
    match /stats/live { allow read: if signedIn(); }
    match /stats/{docId} { allow read: if isAdmin(); }
    match /config/{docId} { allow read: if true; }
  }
}
