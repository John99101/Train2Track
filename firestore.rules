rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Moderation / spam flags are written ONLY by the Cloud Functions (Admin SDK).
    // Clients may leave them out (a set() that replaces the doc drops them, the
    // server re-applies them where needed) but may never set them themselves.
    function noServerFlags() {
      return request.resource.data.get('throttled', false) == false
        && request.resource.data.get('dismissed', false) == false
        && request.resource.data.get('verified', false) == false
        && !('moderatedAt' in request.resource.data);
    }

    // [field] is missing, null, or a string of at most [max] characters.
    function optString(data, field, max) {
      return !(field in data) || data[field] == null
        || (data[field] is string && data[field].size() <= max);
    }

    // A trip id the apps got from transitous. Every one starts with its service day,
    // "20261016_..." (checked on 16 October 2026: all 49,332 live journeys of the
    // nine cities), so made up text is refused.
    function realTripId(tripId) {
      return tripId.matches('[0-9]{8}_.+');
    }
    function validTripId(data) {
      return data.tripId is string && data.tripId.size() <= 300 && realTripId(data.tripId);
    }

    // The trip id made safe for a document name, exactly as every app version does it.
    function tripKey(tripId) {
      return tripId.replace('[^A-Za-z0-9_-]', '-');
    }

    // One document per device per train. Every app that shows the train loads
    // these documents, so their name must not show who wrote them: it is the
    // SHA-256 hash (lowercase hex) of "<uid>__<trip key>". The hash differs on
    // every train, so two entries of one device cannot be linked. The fixed name
    // also means a device cannot create several entries on one train to raise
    // its "!" count. (toHexString() gives capital letters, hence lower().)
    function hiddenTripDoc(docId, tripId) {
      return docId == hashing.sha256(request.auth.uid + '__' + tripKey(tripId)).toHexString().lower();
    }

    // Apps up to 0.4.0 use the name "<uid>__<trip key>" and put the id into the
    // `uid` field. Still accepted; the server renames such a document as soon as
    // it arrives (onReportWritten / onDelayVoteWritten).
    function legacyTripDoc(docId, tripId) {
      return docId == request.auth.uid + '__' + tripKey(tripId);
    }

    // The owner note that belongs to an entry under a hidden name (see doc_owners).
    function ownerNote(collection, docId) {
      return /databases/$(database)/documents/doc_owners/$(collection + '__' + docId);
    }

    // A document the device may write to [collection]: under the hidden name,
    // where the `uid` field repeats the name and never holds the id, and only
    // together with its owner note; or under the old name.
    function ownTripDoc(collection, docId, data) {
      return (hiddenTripDoc(docId, data.tripId) && data.uid == docId
              && existsAfter(ownerNote(collection, docId)))
        || (legacyTripDoc(docId, data.tripId) && data.uid == request.auth.uid);
    }

    // An existing document that belongs to the device (for deleting it).
    function ownStoredDoc(docId, data) {
      return hiddenTripDoc(docId, data.tripId) || data.uid == request.auth.uid;
    }

    // Optional: the city the train was seen in (one of the city ids, or "other"),
    // so each app only loads the reports of the cities it shows. Older app
    // versions send none; the server then files the document under "unknown".
    function validCity(data) {
      return !('city' in data) || data.city in
        ['muenchen', 'berlin', 'hamburg', 'frankfurt', 'nuernberg', 'stuttgart',
         'koeln', 'duesseldorf', 'dortmund', 'leipzig', 'hannover', 'other'];
    }

    // Written now with the server clock (the apps use serverTimestamp()), so a
    // report can't be dated into the future to outlive every "has left" vote.
    function stampedNow(data) {
      return data.createdAt == request.time;
    }

    // Expires within 3 hours (reports live 90 min, delay votes 30 min, occupancy
    // votes 20 min; the rest is room for a phone clock that is a little ahead).
    // Stops a "!" that never ends.
    function shortExpiry(data) {
      return data.expiresAt is timestamp
        && data.expiresAt <= request.time + duration.value(3, 'h');
    }

    // Crowd-sourced train reports.
    match /reports/{reportId} {
      // Any signed-in device (anonymous is fine) may read reports. They do not
      // say who wrote them (see hiddenTripDoc).
      allow read: if signedIn();

      // Only the owner may create/update their own report: their own document, a
      // valid trip, the server time, a short expiry and only the fields the apps
      // write (every app version so far), each with a length limit.
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['localId', 'tripId', 'line', 'station', 'description', 'uid', 'state', 'createdAt', 'expiresAt', 'city'])
        && validTripId(request.resource.data)
        && ownTripDoc('reports', reportId, request.resource.data)
        && validCity(request.resource.data)
        && stampedNow(request.resource.data)
        && shortExpiry(request.resource.data)
        && optString(request.resource.data, 'localId', 100)
        && optString(request.resource.data, 'line', 100)
        && optString(request.resource.data, 'station', 200)
        && optString(request.resource.data, 'description', 500)
        && (!('state' in request.resource.data) || request.resource.data.state in ['entered', 'exited'])
        && noServerFlags();

      // Only the owner may delete their report.
      allow delete: if signedIn()
        && ownStoredDoc(reportId, resource.data);
    }

    // Persistent analytics log of ticket-control events. Clients may only ADD an
    // entry; they can never read, edit or delete the log. Analysis runs server
    // side (controlStats, admin only). The log needs no id: the apps released so
    // far still send theirs (then it must be their own) and the server removes it
    // at once (onControlLogCreated); a later app version can leave it out.
    match /control_log/{entryId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['tripId', 'line', 'station', 'uid', 'createdAt', 'city'])
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
        && request.resource.data.tripId is string
        && request.resource.data.tripId.size() <= 300
        && (request.resource.data.tripId == '' || realTripId(request.resource.data.tripId))
        && validCity(request.resource.data)
        && stampedNow(request.resource.data)
        && optString(request.resource.data, 'line', 100)
        && optString(request.resource.data, 'station', 200);
      allow read, update, delete: if false;
    }

    // Crowd-sourced DELAY votes (Phase 6 / Option 2) — separate from inspector
    // reports so they can never trigger the "!" controller badge. A rider confirms
    // or denies that a train is delayed; one vote per rider per trip.
    match /delay_reports/{voteId} {
      // Any signed-in device may read the votes (to show delay confidence).
      allow read: if signedIn();

      // Only the owner may create/update their own vote: their own document, a
      // valid trip, an allowed vote value, and an expiry.
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['tripId', 'uid', 'vote', 'createdAt', 'expiresAt', 'city'])
        && validTripId(request.resource.data)
        && ownTripDoc('delay_reports', voteId, request.resource.data)
        && validCity(request.resource.data)
        && request.resource.data.vote in ['confirm', 'on_time']
        && stampedNow(request.resource.data)
        && shortExpiry(request.resource.data)
        && noServerFlags();

      // Only the owner may delete their vote.
      allow delete: if signedIn()
        && ownStoredDoc(voteId, resource.data);
    }

    // How full a journey is (apps from 0.6.0 on): one vote per rider per journey,
    // level 1 (many seats free) to 5 (very full). Works like the delay vote, but
    // only under the hidden name with its owner note (no app ever wrote the old name).
    match /occupancy_votes/{voteId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['tripId', 'uid', 'level', 'createdAt', 'expiresAt', 'city'])
        && validTripId(request.resource.data)
        && hiddenTripDoc(voteId, request.resource.data.tripId)
        && request.resource.data.uid == voteId
        && existsAfter(ownerNote('occupancy_votes', voteId))
        && validCity(request.resource.data)
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level <= 5
        && stampedNow(request.resource.data)
        && shortExpiry(request.resource.data)
        && noServerFlags();

      allow delete: if signedIn()
        && hiddenTripDoc(voteId, resource.data.tripId);
    }

    // Nationwide disruptions, written ONLY by the refreshDisruptions Cloud Function
    // (Admin SDK bypasses these rules). Devices read a few KB instead of fetching
    // the 35 MB gtfs.de feed themselves (Phase 6 / Option 2b).
    match /disruptions/{alertId} {
      allow read: if signedIn();
      allow write: if false;   // server (Admin SDK) only
    }

    // Notification tokens of earlier Android versions. The app sends no
    // notifications any more: nothing may be stored here (older app versions
    // still try and are refused), and the hourly cleanup deletes what is left.
    match /users/{uid} { allow read, write: if false; }

    // "App is open" heartbeat for the active users count: only the device's own
    // doc, only the last seen time (server clock) and the platform.
    match /presence/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeen', 'platform'])
        && request.resource.data.lastSeen == request.time
        && request.resource.data.platform in ['android', 'ios'];
      allow delete: if signedIn() && request.auth.uid == uid;
      allow read: if false;
    }

    // Aggregated numbers written by the server: stats/live (active users) may be
    // shown to everyone, anything else in stats is for admins only.
    match /stats/live {
      allow read: if signedIn();
    }
    match /stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Owner notes: which device a report, delay vote or occupancy vote under a hidden name
    // belongs to. The app writes the note together with the entry, the server
    // needs it for the spam limit, moderation and "delete my data". No app can
    // read a note, not even its own.
    match /doc_owners/{noteId} {
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'collection', 'doc', 'tripId', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.collection in ['reports', 'delay_reports', 'occupancy_votes']
        && validTripId(request.resource.data)
        && hiddenTripDoc(request.resource.data.doc, request.resource.data.tripId)
        && noteId == request.resource.data.collection + '__' + request.resource.data.doc
        && shortExpiry(request.resource.data);
      allow read, delete: if false;
    }

    // Settings for the apps, edited only by the owner in the Firebase console:
    // config/app holds androidMinBuild and iosMinBuild, the oldest builds that may
    // still be used (older ones ask for an update). Readable before sign in.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Server only bookkeeping (spam limits, moderation, cached line routes).
    match /rate_limits/{uid} { allow read, write: if false; }
    match /trip_moderation/{tripId} { allow read, write: if false; }
    match /route_cache/{document=**} { allow read, write: if false; }
  }
}
